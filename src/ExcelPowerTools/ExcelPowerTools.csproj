<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ExcelPowerTools</RootNamespace>
    <AssemblyName>ExcelPowerTools</AssemblyName>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <!-- Excel-DNA builds both 32- and 64-bit .xll hosts around this AnyCPU assembly. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Excel-DNA packs the add-in on build; keep the loose files too for debugging. -->
    <RunExcelDnaPack>true</RunExcelDnaPack>
    <!-- net48 has no .deps.json for Excel-DNA to inspect, so name managed dependencies explicitly. -->
    <ExcelAddInInclude>DocumentFormat.OpenXml.dll;DocumentFormat.OpenXml.Framework.dll;DiffPlex.dll</ExcelAddInInclude>
    <!-- Core sources are COMPILED INTO this assembly (see the Compile Include below), so without
         explicit exports every public static Core helper auto-registers as a stray UDF — which is
         how SmartFill.Compose and CsvDescription.Compose collided by bare method name. Only
         [ExcelFunction]/[ExcelCommand] methods are meant to be visible to Excel. -->
    <ExcelAddInExplicitExports>true</ExcelAddInExplicitExports>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core sources are linked into this assembly, so their runtime dependency must also be packed here. -->
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="ExcelDna.Interop" Version="15.0.1">
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <SpreadsheetReviewLicense Include="..\..\licenses\*.txt" />
    <EmbeddedResource Include="@(SpreadsheetReviewLicense)" Link="Licenses\%(Filename)%(Extension)" />
    <None Include="@(SpreadsheetReviewLicense)" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopySpreadsheetReviewLicenses" AfterTargets="Build">
    <Copy SourceFiles="@(SpreadsheetReviewLicense)"
          DestinationFolder="$(OutputPath)publish\licenses" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Compile ALL pure-logic sources straight into the add-in assembly (instead of a project
    reference) so the packed single-file .xll is fully self-contained. The ExcelPowerTools.Core
    project still exists as the unit-test target. New Core files are picked up automatically.
  -->
  <ItemGroup>
    <Compile Include="..\ExcelPowerTools.Core\**\*.cs"
             Exclude="..\ExcelPowerTools.Core\obj\**\*.cs;..\ExcelPowerTools.Core\bin\**\*.cs"
             LinkBase="Core" />
  </ItemGroup>

  <!--
    Bake the repo root into the assembly at build time so the "Framework" ribbon commands can find
    the solution/source no matter where the .xll is loaded from. Re-baked on every build.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
